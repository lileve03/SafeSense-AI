# Local shared demo token: set a unique local value before starting.
# This is not production identity authentication. Never put real secrets in VITE_ variables.
SAFESENSE_API_TOKEN=
# Optional server-only key for trusted live ingestion. Launcher generates one when blank.
# Never create a VITE_ equivalent or expose this key to the browser.
SAFESENSE_INGEST_TOKEN=
TELEGRAM_MODE=disabled
TELEGRAM_BOT_TOKEN=
TELEGRAM_TEST_CHAT_ID=
# Optional numeric Telegram user IDs authorized to confirm TEST receipt and acknowledge test incidents.
# Configure before sending. Reply in the authorized TEST chat: /safesense_ack <one-time code>.
TELEGRAM_TEST_ACK_USER_IDS=
# Public AI candidates use OBSERVE by default; private fusion requires HIGH; SOS is CRITICAL.
TELEGRAM_PUBLIC_AI_MIN_SEVERITY=OBSERVE
# Staff delivery requires BOTH TELEGRAM_MODE=staff and this explicit enable.
TELEGRAM_STAFF_DISPATCH_ENABLED=false
TELEGRAM_SECURITY_CHAT_ID=
TELEGRAM_TEACHER_CHAT_ID=
TELEGRAM_BACKUP_TEACHER_CHAT_ID=
# Absolute path to your private routing JSON, based on staff-routes.example.json
SAFESENSE_STAFF_ROUTES=
SAFESENSE_EVIDENCE_RETENTION_DAYS=7
SAFESENSE_EVIDENCE_PRE_SECONDS=5
SAFESENSE_EVIDENCE_POST_SECONDS=5
# Optional operator-controlled camera registry JSON
SAFESENSE_CAMERA_REGISTRY=
# Optional explicit local pretrained YAMNet directory. Blank uses the existing TF Hub cache.
SAFESENSE_YAMNET_PATH=
# Optional inference-service URL override for scenario video jobs.
# SAFESENSE_AI_URL=http://127.0.0.1:8001

# Automatic public-camera fight baseline: v3 (default) or v2.
# Camera registry entries may override it with "fight_model": "v2" or "v3".
SAFESENSE_FIGHT_BASELINE=v3
